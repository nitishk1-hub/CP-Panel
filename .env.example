# Documentation example; npm start does not automatically load this file.
PANEL_PORT=8787
PANEL_DATA_DIR=/var/lib/server-panel
PANEL_FILE_ROOT=/
PANEL_REQUIRE_SETUP=1
# Initial default only; saved panel-access.json takes precedence.
# Configure DNS, TLS and proxy routing separately before remote access.
# PANEL_PUBLIC_URL=https://panel.example.com
# Optional policy: require MFA before administrators can manage the server.
# Enable only after testing account recovery and enrollment.
# PANEL_REQUIRE_ADMIN_MFA=1
# Installer metadata (core or security); not a runtime capability grant.
# PANEL_INSTALL_PROFILE=core
# Optional policy: ask for password/MFA again after five minutes before
# account, integration, panel-address and protection-mode changes.
# PANEL_REQUIRE_RECENT_AUTH=1
