import fs from 'node:fs/promises';import path from 'node:path';import {execFile} from 'node:child_process';import {promisify} from 'node:util';
const execute=promisify(execFile),base=path.dirname(new URL(import.meta.url).pathname),app='/opt/server-panel/app',backup=path.join(base,'previous-app'),candidate=path.join(base,'candidate'),data='/var/lib/server-panel',waf=path.join(data,'security-center/coraza'),journal=path.join(base,'operation.json');
const systemctl=(...args)=>execute('/usr/bin/systemctl',args,{timeout:45000,maxBuffer:65536});
async function record(phase,details={}){const temp=journal+'.tmp',h=await fs.open(temp,'w',0o600);try{await h.writeFile(JSON.stringify({id:path.basename(base),phase,...details,at:new Date().toISOString()}));await h.sync();}finally{await h.close();}await fs.rename(temp,journal);}
async function exists(file){return fs.access(file).then(()=>true,()=>false);}
async function rollback(reason){const current=await fs.readFile(journal,'utf8').then(JSON.parse,()=>({phase:'prepared'}));if(['committed','rolled-back','prepared','preflight'].includes(current.phase))return;await record('rolling-back',{reason});await systemctl('stop','server-panel.service');if(await exists(backup)){if(await exists(app))await fs.rename(app,path.join(base,'failed-app-'+Date.now()));await fs.rename(backup,app);}for(const name of ['configuration.json','Caddyfile','verification.json'])if(await exists(path.join(base,'waf-backup',name)))await fs.copyFile(path.join(base,'waf-backup',name),path.join(waf,name));await fs.chmod(path.join(waf,'Caddyfile'),0o644);await systemctl('restart','cyberpross-coraza.service');await systemctl('start','server-panel.service');await record('rolled-back',{reason});}
if(process.argv.includes('--recover')){await rollback('Deployment service ended before commit');process.exit(0);}
try{
 await record('preflight');
 const tasks=JSON.parse(await fs.readFile(path.join(data,'tasks.json'),'utf8'));if(tasks.jobs.some(j=>['queued','running'].includes(j.state)&&!j.external))throw Error('Active panel work prevents deployment');
 for(const file of [path.join(data,'maintenance.json'),path.join(data,'network-guard/pending/pending'),path.join(data,'network-guard/pending/rolling-back')])if(await exists(file))throw Error('A maintenance or network operation is pending');
 const vpn=path.join(data,'wireguard/transactions');if(await exists(vpn))for(const dir of await fs.readdir(vpn))for(const name of ['pending','rolling-back'])if(await exists(path.join(vpn,dir,name)))throw Error('A VPN operation is pending');
 const {verifyRelease}=await import(app+'/src/release-integrity.mjs');const key=await fs.readFile('/etc/server-panel/release-public.pem');await verifyRelease(app,key);await verifyRelease(candidate,key);
 await execute('/usr/sbin/nginx',['-t'],{timeout:15000,maxBuffer:65536});await systemctl('is-active','--quiet','server-panel.service','nginx.service','cyberpross-coraza.service','cloudflared.service');
 await fs.mkdir(path.join(base,'waf-backup'),{mode:0o700});for(const name of ['configuration.json','Caddyfile','verification.json'])if(await exists(path.join(waf,name)))await fs.copyFile(path.join(waf,name),path.join(base,'waf-backup',name));
 await record('backed-up');await systemctl('stop','server-panel.service');await record('executing');await fs.rename(app,backup);await fs.rename(candidate,app);await systemctl('start','server-panel.service');
 let ready=false;for(let i=0;i<40;i++){try{const r=await fetch('http://127.0.0.1:8787/',{signal:AbortSignal.timeout(1000)});if(r.ok&&r.headers.get('content-type')?.includes('text/html')&&(await r.text()).includes('<html')){ready=true;break;}}catch{}await new Promise(r=>setTimeout(r,500));}if(!ready)throw Error('Panel startup health check failed');
 await record('validating');const {createCoraza}=await import(app+'/src/security-center/coraza.mjs');const provider=createCoraza({dataDir:data}),configuration=await provider.config();await provider.policy({revision:configuration.revision,panelHosts:['cyber.cyberpross.cc']});await systemctl('restart','cyberpross-coraza.service');for(let i=0;i<30;i++){try{await provider.test();break;}catch(e){if(i===29)throw e;await new Promise(r=>setTimeout(r,500));}}await verifyRelease(app,key);
 const response=await fetch('https://cyber.cyberpross.cc/',{redirect:'error',signal:AbortSignal.timeout(15000)});if(!response.ok||!response.headers.get('content-type')?.includes('text/html')||!(await response.text()).includes('<html'))throw Error('Public panel health check failed');await systemctl('is-active','--quiet','server-panel.service','nginx.service','cyberpross-coraza.service','cloudflared.service');
 await record('committed',{panelHost:'cyber.cyberpross.cc',scope:'Only signed Coraza generator and its existing policy were updated; original application retained for rollback.'});console.log('Management-host WAF repair committed.');
}catch(e){await rollback(e.message);throw e;}
